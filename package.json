{
  "name": "e-learning",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl true --ssl-cert ssl/server.crt --ssl-key ssl/server.key --port 4200",
    "build": "ng build --configuration production",
    "production": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev:ssr": "ng run e-learning:serve-ssr",
    "build:ssr": "ng build && ng run e-learning:server:production",
    "serve:ssr": "node dist/e-learning/server/server.mjs",
    "build:prerender": "ng run e-learning:prerender:production",
    "serve:prerender": "npx http-server dist/e-learning/browser -p 4200"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/cdk": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/material": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/platform-server": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@angular/ssr": "^17.3.15",
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "angular-feather": "^6.5.0",
    "aos": "^2.3.4",
    "bootstrap": "^5.3.2",
    "countup.js": "^2.9.0",
    "crypto-js": "^4.2.0",
    "express": "^4.18.2",
    "google-libphonenumber": "^3.2.40",
    "intl-tel-input": "^19.5.7",
    "ng2-pdf-viewer": "^10.4.0",
    "ngx-bootstrap": "^12.0.0",
    "ngx-cookie-service": "^17.0.1",
    "ngx-material-intl-tel-input": "^17.3.0",
    "ngx-owl-carousel-o": "^17.0.0",
    "ngx-spinner": "^17.0.0",
    "rxjs": "~7.8.1",
    "sweetalert2": "^11.15.10",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.8",
    "@angular-eslint/builder": "^17.3.0",
    "@angular-eslint/eslint-plugin": "^17.3.0",
    "@angular-eslint/eslint-plugin-template": "^17.3.0",
    "@angular-eslint/schematics": "^17.3.0",
    "@angular-eslint/template-parser": "^17.3.0",
    "@angular/cli": "^17.3.8",
    "@angular/compiler-cli": "^17.3.0",
    "@types/aos": "^3.0.7",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "compression-webpack-plugin": "^11.1.0",
    "eslint": "^8.56.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.4.2"
